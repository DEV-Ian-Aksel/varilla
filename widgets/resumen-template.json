{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "TextBlock",
      "size": "Medium",
      "weight": "Bolder",
      "wrap": true,
      "text": "Varilla para columnas"
    },
    {
      "type": "TextBlock",
      "spacing": "Small",
      "isSubtle": true,
      "wrap": true,
      "text": "${seccion}"
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "size": "Small",
              "isSubtle": true,
              "text": "Cuantía"
            },
            {
              "type": "TextBlock",
              "size": "Large",
              "weight": "Bolder",
              "text": "${cuantia}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "size": "Small",
              "isSubtle": true,
              "text": "Varillas"
            },
            {
              "type": "TextBlock",
              "size": "Large",
              "weight": "Bolder",
              "text": "${barrasLong}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "size": "Small",
              "isSubtle": true,
              "text": "Estribos"
            },
            {
              "type": "TextBlock",
              "size": "Large",
              "weight": "Bolder",
              "text": "${barrasEst}"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "spacing": "Medium",
      "size": "Small",
      "wrap": true,
      "text": "${estado}"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Abrir calculadora",
      "verb": "open-app"
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
